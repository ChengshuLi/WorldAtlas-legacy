+def join_group(phase, *, plan_pin, aggregation_plan_pin, group_ordinal, acquisition, project_guard):
+    """Genuine detached subset join, never global completion."""
+    a=acquisition;project_guard();plan,scope=_scope(phase,plan_pin,a)
+    aggregation=aggregation_plan(phase,plan_pin,aggregation_plan_pin,plan,scope,a)
+    required=group_dependencies(plan_pin,aggregation_plan_pin,plan,aggregation,group_ordinal,a)
+    a.require(all(phase.pins.get(a.Phase.key(p))==p for p in required),'Omitted whole group operand')
+    group=aggregation['groups'][group_ordinal];ordinals=group['cohort_ordinals']
+    native=_native(phase,plan['native'],plan,a)
+    components,geometry,statuses,requests=_collect_children(phase,plan_pin,plan,scope,ordinals,
+                         [aggregation['verification_specs'][n] for n in ordinals],a)
+    native_final={i:dict(native[i]['alias'],source_id=i,complete_original_metadata=native[i]['complete_original_metadata']) for i in native}
+    inverses=_inverse_outputs(phase,requests,components,geometry,native_final,a)
+    phase.rows('components',(components[i] for i in sorted(components)))
+    phase.rows('geometry-objects',(geometry[i] for i in sorted(geometry)))
+    phase.rows('scientific-stage-inverses',inverses)
