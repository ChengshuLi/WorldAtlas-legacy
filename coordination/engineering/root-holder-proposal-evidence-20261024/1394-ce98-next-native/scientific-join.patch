+        ordered_query_scope_sha256=_query_scope(group['component_ids'],scope,a),statuses=dict(sorted(statuses.items())),
+        independent_child_roster_sha256=a.sha(a.canonical([{'source':plan['cohorts'][n],
+                    'verification':aggregation['verification_specs'][n]} for n in ordinals])),
+        original_source_shard_inverses=len(inverses),global_completion=False))
