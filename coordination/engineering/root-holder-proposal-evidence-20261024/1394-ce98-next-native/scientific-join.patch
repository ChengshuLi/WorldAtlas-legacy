+def aggregation_plan(phase,plan_pin,aggregation_plan_pin,plan,scope,a):
+    """Whole independently frozen partition and prior actual verification rosters."""
+    value=json.loads(phase.read(aggregation_plan_pin))
+    a.require(set(value)=={'kind','version','source_plan_pin','counts','groups','verification_specs'},
+              'Unknown/omitted aggregation authority fields')
+    a.require(value.get('kind')=='complete-original-scientific-aggregation-plan' and
+              value.get('version')==1 and value.get('source_plan_pin')==plan_pin and
+              value.get('counts')==COUNTS and len(plan['cohorts'])==105,
+              'Wrong complete105 scientific aggregation authority')
+    checks=value['verification_specs'];groups=value['groups']
+    a.require(len(checks)==105 and groups and len(groups)<=105,
+              'Omitted original scientific verification or group partition')
+    all_ids=[]
+    for spec in plan['cohorts']:
+        ids=spec['component_ids']
+        a.require(ids and ids==sorted(set(ids)) and all(i in scope for i in ids),
+                  'Foreign/duplicate original scientific cohort scope')
+        all_ids.extend(ids)
+    a.require(len(all_ids)==1294 and len(set(all_ids))==1294 and set(all_ids)==set(scope),
+              'Original105 cohorts do not partition complete1294 scope')
+    seen=[]
+    for number,group in enumerate(groups):
+        ordinals=group['cohort_ordinals']
+        a.require(set(group)=={'ordinal','cohort_ordinals','component_ids','ordered_queries'},
+                  'Unknown/omitted typed group fields')
+        a.require(group['ordinal']==number and type(group['ordinal']) is int and ordinals and
+                  ordinals==sorted(set(ordinals)) and all(type(n) is int and 0<=n<105 for n in ordinals),
+                  'Foreign/duplicate/unordered typed aggregation ordinal')
+        ids=sorted(i for n in ordinals for i in plan['cohorts'][n]['component_ids'])
+        a.require(group['component_ids']==ids and group['ordered_queries']==sum(scope[i]['query_count'] for i in ids),
+                  'Changed complete group component/query scope')
+        seen.extend(ordinals)
+    a.require(len(seen)==105 and sorted(seen)==list(range(105)),
+              'Omitted/duplicated original cohort partition')
+    return value
+
