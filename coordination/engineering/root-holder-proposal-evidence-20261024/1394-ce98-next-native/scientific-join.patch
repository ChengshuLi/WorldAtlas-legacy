+def group_dependencies(plan_pin,aggregation_plan_pin,plan,aggregation,ordinal,a):
+    """Exact original numerical/check/native files; code/root closure added by caller."""
+    a.require(type(ordinal) is int and 0<=ordinal<len(aggregation['groups']), 'Foreign group selection')
+    native=plan['native'];pins=[plan_pin,aggregation_plan_pin,native['publication'],native['inventory'],*native['outputs']]
+    for n in aggregation['groups'][ordinal]['cohort_ordinals']:
+        a.require(type(n) is int and 0<=n<len(plan['cohorts']) and n<len(aggregation['verification_specs']),
+                  'Foreign complete group cohort ordinal')
+        source=plan['cohorts'][n];check=aggregation['verification_specs'][n]
+        pins += [source['publication'],source['inventory'],*source['outputs'],check['publication'],check['inventory']]
+        a.require(not check['outputs'],'Foreign original verification product')
+    return list(_roster_unique(pins,a).values())
+
+
+def _roster_unique(pins,a):
+    result={}
+    for pin in pins:
+        a.bounds(pin);key=a.Phase.key(pin)
+        a.require(key not in result or result[key]==pin,'Conflicting scientific input alias')
+        result[key]=pin
+    return result
+
