+         codec_pin.get('commit')==commit,'Wrong actual custody head/codec; original science head is distinct')
+    need(rp['bytes']<=1048576 and fp['bytes']<=1048576 and
+         'uncompressed_bytes' not in rp and 'uncompressed_bytes' not in fp,
+         'Bounded whole proof root context required')
+    request=json.loads(phase.read(rp));freeze=json.loads(phase.read(fp))
+    need(request.get('execution_commit')==freeze.get('execution_commit')==commit and
+         request.get('issue')==freeze.get('issue')==1394 and
